      if ($manifest.schemaVersion -ne 2 -or $manifest.packageId -ne 'MVVCVTK.Sdk') { throw 'Unsupported SDK manifest schema or package id.'; }
      if ($manifest.packageVersion -ne '__SDK_VERSION__' -or $manifest.directoryVersion -ne '__SDK_DIRECTORY__') { throw 'SDK package version does not match its requested directory.'; }
      if ($manifest.platform -ne 'windows' -or $manifest.architecture -ne 'x64' -or $manifest.libraryKind -ne 'static') { throw 'SDK platform or library kind mismatch.'; }
      if ($manifest.featureTrust -ne 'trusted-in-process') { throw 'SDK Feature trust policy mismatch.'; }
      if ($manifest.abiPolicy.compatibility -ne 'fixed-toolchain' -or $manifest.abiPolicy.platformToolset -ne 'v145' -or $manifest.abiPolicy.stableBinaryAbi) { throw 'SDK ABI policy is incomplete.'; }
      if (@($manifest.artifacts | Group-Object path | Where-Object { $_.Count -ne 1 }).Count -ne 0) { throw 'SDK artifact paths must be unique.'; }
      foreach ($artifact in $manifest.artifacts) {
        $fullPath = Get-SdkPath $root $artifact.path;
        if (-not [IO.File]::Exists($fullPath)) { throw ('SDK artifact is missing: ' + $artifact.path); }
        $file = Get-Item -LiteralPath $fullPath;
        if ($file.Length -ne $artifact.bytes) { throw ('SDK artifact byte count mismatch: ' + $artifact.path); }
        $hash = Get-SdkHash $fullPath;
        if ($hash -ne $artifact.sha256) { throw ('SDK artifact hash mismatch: ' + $artifact.path); }
      };
      $declaredHeaders = @($manifest.artifacts | Where-Object { $_.path -like 'include/*.h' } | ForEach-Object { $_.path.Substring(8) } | Sort-Object);
      $includeRoot = Join-Path $root 'include';
      $actualHeaders = @(Get-ChildItem -LiteralPath $includeRoot -Recurse -File -Filter '*.h' | ForEach-Object { $_.FullName.Substring($includeRoot.Length + 1).Replace('\', '/') } | Sort-Object);
      if ($actualHeaders.Count -ne $manifest.publicSurface.headerClosureCount -or $declaredHeaders.Count -ne $actualHeaders.Count) { throw 'SDK public header closure count mismatch.'; }
      if (@(Compare-Object $declaredHeaders $actualHeaders).Count -ne 0) { throw 'SDK include directory contains a missing or undeclared public header.'; }
      foreach ($entryHeader in $manifest.publicSurface.entryHeaders) { if ($declaredHeaders -notcontains $entryHeader) { throw ('SDK entry header is outside the declared closure: ' + $entryHeader); } }
      $declaredLibraries = @('Debug/MVVCVTK.lib', 'Release/MVVCVTK.lib');
      $libraryRoot = Join-Path $root 'lib';
      $actualLibraries = @(Get-ChildItem -LiteralPath $libraryRoot -Recurse -File | ForEach-Object { $_.FullName.Substring($libraryRoot.Length + 1).Replace('\', '/') } | Sort-Object);
      if (@(Compare-Object $declaredLibraries $actualLibraries).Count -ne 0) { throw 'SDK lib directory contains a missing or undeclared artifact.'; }
      $depsPath = Join-Path $root 'deps/manifest.json';
      $deps = Get-Content -LiteralPath $depsPath -Raw | ConvertFrom-Json;
      if ($deps.packageVersion -ne '__DEPS_VERSION__' -or $manifest.dependencies.packageVersion -ne $deps.packageVersion) { throw 'Packaged dependency version mismatch.'; }
      if ((Get-SdkHash $depsPath) -ne $manifest.dependencies.manifestSha256) { throw 'Packaged dependency manifest hash mismatch.'; }
      $depsRoot = Join-Path $root 'deps';
      $declaredDeps = @($manifest.dependencies.artifacts);
      if (@($declaredDeps | Group-Object path | Where-Object { $_.Count -ne 1 }).Count -ne 0) { throw 'Dependency artifact paths must be unique.'; }
      $declaredDepPaths = @($declaredDeps | ForEach-Object { $_.path } | Sort-Object);
      $actualDepPaths = @(Get-ChildItem -LiteralPath $depsRoot -Recurse -File | ForEach-Object { $_.FullName.Substring($depsRoot.Length + 1).Replace('\', '/') } | Sort-Object);
      if ($declaredDeps.Count -ne $manifest.dependencies.artifactCount -or @(Compare-Object $declaredDepPaths $actualDepPaths).Count -ne 0) { throw 'Packaged dependency artifact closure mismatch.'; }
      foreach ($artifact in $declaredDeps) {
        $fullPath = Get-SdkPath $depsRoot $artifact.path;
        $file = Get-Item -LiteralPath $fullPath;
        if ($file.Length -ne $artifact.bytes -or (Get-SdkHash $fullPath) -ne $artifact.sha256) { throw ('Packaged dependency artifact mismatch: ' + $artifact.path); }
      };
      foreach ($sentinel in $deps.sentinels) {
        $fullPath = Get-SdkPath $depsRoot $sentinel.path;
        if (-not [IO.File]::Exists($fullPath)) { throw ('Dependency sentinel is missing: ' + $sentinel.path); }
        $file = Get-Item -LiteralPath $fullPath;
        if ($file.Length -ne $sentinel.bytes) { throw ('Dependency sentinel byte count mismatch: ' + $sentinel.path); }
        if ((Get-SdkHash $fullPath) -ne $sentinel.sha256) { throw ('Dependency sentinel hash mismatch: ' + $sentinel.path); }
      };
    </MVVCVTKSdkVerifyScript>
  </PropertyGroup>
