<Project>
  <PropertyGroup>
    <MVVCVTKSdkWasImported>$(MVVCVTKSdkImported)</MVVCVTKSdkWasImported>
    <MVVCVTKSdkRoot Condition="'$(MVVCVTKSdkRoot)' == ''">$(MSBuildThisFileDirectory)</MVVCVTKSdkRoot>
    <MVVCVTKSdkRoot>$([System.IO.Path]::GetFullPath('$(MVVCVTKSdkRoot)\.'))</MVVCVTKSdkRoot>
    <MVVCVTKSdkDirectoryName>$([System.IO.Path]::GetFileName('$(MVVCVTKSdkRoot)'))</MVVCVTKSdkDirectoryName>
    <MVVCVTKSdkResolvedVersion>$([System.String]::Copy('$(MVVCVTKSdkDirectoryName)').Replace('-win-x64', ''))</MVVCVTKSdkResolvedVersion>
    <MVVCVTKDepsRoot Condition="'$(MVVCVTKDepsRoot)' == ''">$(MVVCVTKSdkRoot)\deps</MVVCVTKDepsRoot>
    <MVVCVTKDepsProps>$(MVVCVTKDepsRoot)\MVVCVTK.Dependencies.props</MVVCVTKDepsProps>
  </PropertyGroup>

  <Import Project="$(MVVCVTKDepsProps)"
          Condition="'$(MVVCVTKDepsImported)' != 'true' and Exists('$(MVVCVTKDepsProps)')" />

  <PropertyGroup>
    <MVVCVTKSdkInclude>$(MVVCVTKSdkRoot)\include</MVVCVTKSdkInclude>
    <MVVCVTKSdkLibraryDir>$(MVVCVTKSdkRoot)\lib\$(Configuration)</MVVCVTKSdkLibraryDir>
    <MVVCVTKVtkSuffix Condition="'$(Configuration)' == 'Debug'">d</MVVCVTKVtkSuffix>
    <MVVCVTKVtkSuffix Condition="'$(Configuration)' != 'Debug'"></MVVCVTKVtkSuffix>
    <MVVCVTKVtkLibraries>vtkCommonCore-9.4$(MVVCVTKVtkSuffix).lib;vtkCommonDataModel-9.4$(MVVCVTKVtkSuffix).lib;vtkCommonExecutionModel-9.4$(MVVCVTKVtkSuffix).lib;vtkCommonMath-9.4$(MVVCVTKVtkSuffix).lib;vtkCommonTransforms-9.4$(MVVCVTKVtkSuffix).lib;vtksys-9.4$(MVVCVTKVtkSuffix).lib;vtkFiltersCore-9.4$(MVVCVTKVtkSuffix).lib;vtkFiltersGeneral-9.4$(MVVCVTKVtkSuffix).lib;vtkFiltersGeometry-9.4$(MVVCVTKVtkSuffix).lib;vtkFiltersSources-9.4$(MVVCVTKVtkSuffix).lib;vtkIOCore-9.4$(MVVCVTKVtkSuffix).lib;vtkIOGeometry-9.4$(MVVCVTKVtkSuffix).lib;vtkIOImage-9.4$(MVVCVTKVtkSuffix).lib;vtkIOPLY-9.4$(MVVCVTKVtkSuffix).lib;vtkImagingCore-9.4$(MVVCVTKVtkSuffix).lib;vtkImagingGeneral-9.4$(MVVCVTKVtkSuffix).lib;vtkImagingStatistics-9.4$(MVVCVTKVtkSuffix).lib;vtkInteractionStyle-9.4$(MVVCVTKVtkSuffix).lib;vtkInteractionWidgets-9.4$(MVVCVTKVtkSuffix).lib;vtkRenderingAnnotation-9.4$(MVVCVTKVtkSuffix).lib;vtkRenderingCore-9.4$(MVVCVTKVtkSuffix).lib;vtkRenderingFreeType-9.4$(MVVCVTKVtkSuffix).lib;vtkRenderingImage-9.4$(MVVCVTKVtkSuffix).lib;vtkRenderingLOD-9.4$(MVVCVTKVtkSuffix).lib;vtkRenderingOpenGL2-9.4$(MVVCVTKVtkSuffix).lib;vtkRenderingVolume-9.4$(MVVCVTKVtkSuffix).lib;vtkRenderingVolumeOpenGL2-9.4$(MVVCVTKVtkSuffix).lib</MVVCVTKVtkLibraries>
    <MVVCVTKSdkImported>true</MVVCVTKSdkImported>
    <MVVCVTKSdkVerifyScript>
      $ErrorActionPreference = 'Stop';
      Import-Module Microsoft.PowerShell.Utility -ErrorAction Stop;
      function Get-SdkHash([string]$path) { $stream = [IO.File]::Open($path, [IO.FileMode]::Open, [IO.FileAccess]::Read, [IO.FileShare]::Read); try { $sha = [Security.Cryptography.SHA256]::Create(); try { return [BitConverter]::ToString($sha.ComputeHash($stream)).Replace('-', ''); } finally { $sha.Dispose(); } } finally { $stream.Dispose(); } }
      function Get-SdkPath([string]$base, [string]$relative) { if ([string]::IsNullOrWhiteSpace($relative) -or [IO.Path]::IsPathRooted($relative) -or $relative.Contains('\')) { throw ('Unsafe SDK artifact path: ' + $relative); }; $segments = @($relative.Split('/')); if (@($segments | Where-Object { $_ -eq '' -or $_ -eq '.' -or $_ -eq '..' }).Count -ne 0) { throw ('Unsafe SDK artifact path: ' + $relative); }; $basePath = [IO.Path]::GetFullPath($base); $prefix = $basePath; if (-not $prefix.EndsWith([string][IO.Path]::DirectorySeparatorChar)) { $prefix += [IO.Path]::DirectorySeparatorChar; }; $fullPath = [IO.Path]::GetFullPath((Join-Path $basePath $relative)); if (-not $fullPath.StartsWith($prefix, [StringComparison]::OrdinalIgnoreCase)) { throw ('SDK artifact escapes its root: ' + $relative); }; return $fullPath; }
      $root = [IO.Path]::GetFullPath('$(MVVCVTKSdkRoot)');
      $manifestPath = Join-Path $root 'manifest.json';
      if (-not [IO.File]::Exists($manifestPath)) { throw 'SDK manifest is missing.'; }
      $manifest = Get-Content -LiteralPath $manifestPath -Raw | ConvertFrom-Json;
      if ($manifest.schemaVersion -ne 2 -or $manifest.packageId -ne 'MVVCVTK.Sdk') { throw 'Unsupported SDK manifest schema or package id.'; }
      if ($manifest.packageVersion -ne '$(MVVCVTKSdkResolvedVersion)' -or $manifest.directoryVersion -ne '$(MVVCVTKSdkDirectoryName)') { throw 'SDK folder and manifest versions differ.'; }
      if ($manifest.platform -ne 'windows' -or $manifest.architecture -ne 'x64' -or $manifest.libraryKind -ne 'static') { throw 'SDK platform or library kind mismatch.'; }
      if ($manifest.featureTrust -ne 'trusted-in-process') { throw 'SDK Feature trust policy mismatch.'; }
      if ($manifest.abiPolicy.compatibility -ne 'fixed-toolchain' -or $manifest.abiPolicy.platformToolset -ne 'v145' -or $manifest.abiPolicy.stableBinaryAbi) { throw 'SDK ABI policy is incomplete.'; }
      if ([string]$manifest.abiPolicy.msvcToolsVersion -ne '$(VCToolsVersion)') { throw 'SDK MSVC tools version mismatch.'; }
      if (@($manifest.artifacts | Group-Object path | Where-Object { $_.Count -ne 1 }).Count -ne 0) { throw 'SDK artifact paths must be unique.'; }
      foreach ($artifact in $manifest.artifacts) {
        $fullPath = Get-SdkPath $root $artifact.path;
        if (-not [IO.File]::Exists($fullPath)) { throw ('SDK artifact is missing: ' + $artifact.path); }
        $file = Get-Item -LiteralPath $fullPath;
        if ($file.Length -ne $artifact.bytes) { throw ('SDK artifact byte count mismatch: ' + $artifact.path); }
        if ((Get-SdkHash $fullPath) -ne $artifact.sha256) { throw ('SDK artifact hash mismatch: ' + $artifact.path); }
      };
      $declaredHeaders = @($manifest.artifacts | Where-Object { $_.path -like 'include/*.h' } | ForEach-Object { $_.path.Substring(8) } | Sort-Object);
      $includeRoot = Join-Path $root 'include';
      $actualHeaders = @(Get-ChildItem -LiteralPath $includeRoot -Recurse -File -Filter '*.h' | ForEach-Object { $_.FullName.Substring($includeRoot.Length + 1).Replace('\', '/') } | Sort-Object);
      if ($actualHeaders.Count -ne $manifest.publicSurface.headerClosureCount -or $declaredHeaders.Count -ne $actualHeaders.Count) { throw 'SDK public header closure count mismatch.'; }
      if (@(Compare-Object $declaredHeaders $actualHeaders).Count -ne 0) { throw 'SDK include directory contains a missing or undeclared public header.'; }
      foreach ($entryHeader in $manifest.publicSurface.entryHeaders) { if ($declaredHeaders -notcontains $entryHeader) { throw ('SDK entry header is outside the declared closure: ' + $entryHeader); } }
      $declaredLibraries = @('Debug/MVVCVTK.lib', 'Release/MVVCVTK.lib');
      $libraryRoot = Join-Path $root 'lib';
      $actualLibraries = @(Get-ChildItem -LiteralPath $libraryRoot -Recurse -File | ForEach-Object { $_.FullName.Substring($libraryRoot.Length + 1).Replace('\', '/') } | Sort-Object);
      if (@(Compare-Object $declaredLibraries $actualLibraries).Count -ne 0) { throw 'SDK lib directory contains a missing or undeclared artifact.'; }
      $depsPath = Join-Path $root 'deps/manifest.json';
      $deps = Get-Content -LiteralPath $depsPath -Raw | ConvertFrom-Json;
      if ($manifest.dependencies.packageVersion -ne $deps.packageVersion) { throw 'Packaged dependency version mismatch.'; }
      if ((Get-SdkHash $depsPath) -ne $manifest.dependencies.manifestSha256) { throw 'Packaged dependency manifest hash mismatch.'; }
      $depsRoot = Join-Path $root 'deps';
      $declaredDeps = @($manifest.dependencies.artifacts);
      if (@($declaredDeps | Group-Object path | Where-Object { $_.Count -ne 1 }).Count -ne 0) { throw 'Dependency artifact paths must be unique.'; }
      $declaredDepPaths = @($declaredDeps | ForEach-Object { $_.path } | Sort-Object);
      $actualDepPaths = @(Get-ChildItem -LiteralPath $depsRoot -Recurse -File | ForEach-Object { $_.FullName.Substring($depsRoot.Length + 1).Replace('\', '/') } | Sort-Object);
      if ($declaredDeps.Count -ne $manifest.dependencies.artifactCount -or @(Compare-Object $declaredDepPaths $actualDepPaths).Count -ne 0) { throw 'Packaged dependency artifact closure mismatch.'; }
      foreach ($artifact in $declaredDeps) {
        $fullPath = Get-SdkPath $depsRoot $artifact.path;
        if (-not [IO.File]::Exists($fullPath)) { throw ('Dependency artifact is missing: ' + $artifact.path); }
        $file = Get-Item -LiteralPath $fullPath;
        if ($file.Length -ne $artifact.bytes -or (Get-SdkHash $fullPath) -ne $artifact.sha256) { throw ('Packaged dependency artifact mismatch: ' + $artifact.path); }
      };
      foreach ($sentinel in $deps.sentinels) {
        $fullPath = Get-SdkPath $depsRoot $sentinel.path;
        if (-not [IO.File]::Exists($fullPath)) { throw ('Dependency sentinel is missing: ' + $sentinel.path); }
        $file = Get-Item -LiteralPath $fullPath;
        if ($file.Length -ne $sentinel.bytes) { throw ('Dependency sentinel byte count mismatch: ' + $sentinel.path); }
        if ((Get-SdkHash $fullPath) -ne $sentinel.sha256) { throw ('Dependency sentinel hash mismatch: ' + $sentinel.path); }
      };
    </MVVCVTKSdkVerifyScript>
    <MVVCVTKSdkVerifyCommand>$(MVVCVTKSdkVerifyScript.Replace('%0A', ' '))</MVVCVTKSdkVerifyCommand>
  </PropertyGroup>

  <ItemDefinitionGroup Condition="'$(MVVCVTKSdkWasImported)' != 'true' and '$(Platform)' == 'x64'">
    <ClCompile>
      <AdditionalIncludeDirectories>$(MVVCVTKSdkInclude);$(VtkRoot)\include\vtk-9.4;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>MVVCVTK_SDK_CONSUMER;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
      <RuntimeLibrary Condition="'$(Configuration)' == 'Debug'">MultiThreadedDebugDLL</RuntimeLibrary>
      <RuntimeLibrary Condition="'$(Configuration)' == 'Release'">MultiThreadedDLL</RuntimeLibrary>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(MVVCVTKSdkLibraryDir);$(VtkRoot)\lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>MVVCVTK.lib;$(MVVCVTKVtkLibraries);%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <Target Name="MVVCVTKCheckSdkFiles"
          BeforeTargets="PrepareForBuild"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="'$(Platform)' != 'x64'"
           Text="MVVCVTK SDK 仅支持 x64；当前平台为 '$(Platform)'。" />
    <Error Condition="'$(Configuration)' != 'Debug' and '$(Configuration)' != 'Release'"
           Text="MVVCVTK SDK 仅提供 Debug 与 Release 固定工具链产物；当前配置为 '$(Configuration)'。" />
    <Error Condition="'$(PlatformToolset)' != 'v145'"
           Text="MVVCVTK SDK 固定使用 MSVC v145；当前工具集为 '$(PlatformToolset)'。" />
    <Error Condition="'$(MVVCVTKDepsImported)' != 'true'"
           Text="MVVCVTK SDK dependency bundle is missing at '$(MVVCVTKDepsRoot)'." />
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -Command &quot;&amp; { $(MVVCVTKSdkVerifyCommand) }&quot;" />
  </Target>
</Project>
