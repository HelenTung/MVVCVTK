{
  "schema": "qt-control-scenario-1",
  "checkWindowLocked": true,
  "viewsVisible": true,
  "viewLayout": "Inspection",
  "steps": [
    {"control":"checkPage","module":"Data"},
    {"control":"checkPage","module":"View"},
    {"control":"checkPage","module":"Rotation"},
    {"control":"checkPage","module":"Artifact"},
    {"control":"checkPage","module":"Roi"},
    {"control":"checkPage","module":"Crop"},
    {"control":"checkPage","module":"Part"},
    {"control":"checkPage","module":"Surface"},
    {"control":"checkPage","module":"Alignment"},
    {"control":"checkPage","module":"Wall"},
    {"control":"checkPage","module":"Gap"},
    {"control":"businessPrimary","module":"Data","action":"Load","expectPrimaryAction":"Load","parameters":{},"expectStatus":"Succeeded","saveAs":"loaded","performanceCheckpoint":"@Output/load-performance.json","screenshot":"@Output/full-input.png","showStatistics":true,"waitHistogram":true,"statisticsAudit":"@Output/full-input-statistics.json","statisticsScreenshot":"@Output/full-input-statistics.png"},
    {"control":"businessPrimary","module":"View","action":"Set","parameters":{"viewId":"primary-3d","mode":"CompositeVolume"},"expectPrimaryAction":"Set","expectStatus":"Succeeded"},
    {"control":"actionButton","module":"Rotation","action":"SetEnabled","parameters":{"isEnabled":true},"expectStatus":"Succeeded"},
    {"control":"businessPrimary","module":"Rotation","action":"Rotate","parameters":{"angleDeg":5,"worldAxis":[0,0,1]},"expectPrimaryAction":"Rotate","expectStatus":"Succeeded"},
    {"control":"actionButton","module":"Rotation","action":"Undo","expectStatus":"Succeeded"},
    {"control":"businessPrimary","module":"Roi","action":"Begin","expectPrimaryAction":"Begin","expectStatus":"Succeeded"},
    {"control":"businessPrimary","module":"Roi","action":"Commit","expectPrimaryAction":"Commit","expectStatus":"Succeeded","showStatistics":true,"waitHistogram":true,"statisticsAudit":"@Output/roi-statistics.json","statisticsScreenshot":"@Output/roi-statistics.png"},
    {"control":"nextButton","module":"Surface","action":"Preview","parameterAction":"GlobalAutomatic","parameters":{"initialIsoValue":null,"materialRange":null,"componentSelection":"All","roiModelBounds":null},"expectStatus":"Succeeded","performanceCheckpoint":"@Output/surface-preview-performance.json"},
    {"control":"businessPrimary","module":"Surface","action":"Determine","parameterAction":"GlobalAutomatic","expectPrimaryAction":"Determine","expectStatus":"Succeeded","saveAs":"surface","showStatistics":true,"waitHistogram":true,"statisticsAudit":"@Output/surface-statistics.json","statisticsScreenshot":"@Output/surface-statistics.png","performanceCheckpoint":"@Output/surface-performance.json"},
    {"control":"businessPrimary","module":"Part","action":"Start","parameters":{"threshold":"$surface.result.isoEstimate.iso"},"expectPrimaryAction":"Start","expectStatus":"Succeeded","screenshot":"@Output/parts.png","performanceCheckpoint":"@Output/part-performance.json"},
    {"control":"businessPrimary","module":"Gap","action":"Start","parameters":{"isoMode":"AbsoluteValue","absoluteIsoValue":"$surface.result.isoEstimate.iso","filter":false},"expectPrimaryAction":"Start","expectStatus":"Succeeded","saveAs":"gap","performanceCheckpoint":"@Output/gap-performance.json"},
    {"control":"businessPrimary","module":"Gap","action":"Defects","expectPrimaryAction":"Defects","expectStatus":"Observed","showStatistics":true,"waitStatistics":true,"statisticsAudit":"@Output/gap-statistics.json","screenshot":"@Output/gap.png"},
    {"control":"businessPrimary","module":"Crop","action":"Start","parameters":{"shape":"Box","removalMode":"KeepInside"},"waitForCropFrames":true,"expectPrimaryAction":"Start","expectStatus":"Succeeded","cropDrag":true,"cropDragAudit":"@Output/crop-drag.json"},
    {"control":"businessPrimary","module":"Crop","action":"FinishEditing","waitForCropFrames":true,"expectPrimaryAction":"FinishEditing","expectStatus":"PreviewConfirmed"},
    {"control":"businessPrimary","module":"Crop","action":"BuildResult","waitForCropFrames":true,"expectPrimaryAction":"BuildResult","expectStatus":"Published","expectFollowupStatus":"Succeeded","expectAdoptPublished":true,"saveAs":"cropped","screenshot":"@Output/crop-used.png","showStatistics":true,"waitHistogram":true,"statisticsAudit":"@Output/crop-statistics.json","performanceCheckpoint":"@Output/crop-performance.json"}
  ]
}
