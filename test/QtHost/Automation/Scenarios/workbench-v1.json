{
  "schema": "qt-control-scenario-1",
  "checkWindowLocked": true,
  "viewsVisible": true,
  "viewLayout": "FourViews",
  "steps": [
    {"control":"checkPage","module":"Data"},
    {"control":"checkPage","module":"View"},
    {"control":"checkPage","module":"Rotation"},
    {"control":"checkPage","module":"Roi"},
    {"control":"checkPage","module":"Crop"},
    {"control":"checkPage","module":"Artifact"},
    {"control":"checkPage","module":"Part"},
    {"control":"checkPage","module":"Surface"},
    {"control":"checkPage","module":"Alignment"},
    {"control":"checkPage","module":"Wall"},
    {"control":"checkPage","module":"Gap"},
    {"control":"businessPrimary","module":"Data","action":"Load","expectPrimaryAction":"Load","parameters":{},"expectStatus":"Succeeded","saveAs":"loaded","screenshot":"@Output/input.png","showStatistics":true,"waitHistogram":true,"statisticsAudit":"@Output/input-statistics.json"},
    {"control":"actionButton","module":"View","action":"SetVolumeVisible","parameters":{"graphRevision":"$loaded.current.dataRevision","isVisible":false},"expectStatus":"Succeeded"},
    {"control":"actionButton","module":"View","action":"SetVolumeVisible","parameters":{"graphRevision":"$loaded.current.dataRevision","isVisible":true},"expectStatus":"Succeeded"},
    {"control":"businessPrimary","module":"Roi","action":"Begin","parameters":{"shape":"Sphere","radius":2.0},"expectPrimaryAction":"Begin","expectStatus":"Succeeded"},
    {"control":"businessPrimary","module":"Roi","action":"Commit","expectPrimaryAction":"Commit","expectStatus":"Succeeded","expectRoiCount":1,"expectRoiShape":"Sphere","saveAs":"roi","stateAudit":"@Output/roi-original.json","screenshot":"@Output/roi.png"},
    {"control":"actionButton","module":"Roi","action":"Dilate","parameters":{"roi":"$roi.result.roi","outputMode":"CreateNew","radius":0.3,"radiusUnit":"Millimetres"},"expectStatus":"PreviewReady"},
    {"control":"businessPrimary","module":"Roi","action":"Commit","expectPrimaryAction":"Commit","expectStatus":"Succeeded","expectRoiCount":2,"expectRetainedRoi":"$roi.result.roi","saveAs":"expandedRoi","stateAudit":"@Output/roi-expanded.json"},
    {"control":"nextButton","module":"Surface","action":"Preview","parameterAction":"GlobalAutomatic","parameters":{"initialIsoValue":null,"materialRange":null,"componentSelection":"All","analysisRoi":""},"expectStatus":"Succeeded"},
    {"control":"businessPrimary","module":"Surface","action":"Determine","parameterAction":"GlobalAutomatic","expectPrimaryAction":"Determine","expectStatus":"Succeeded","saveAs":"surface","showStatistics":true,"waitHistogram":true,"statisticsAudit":"@Output/surface-statistics.json","screenshot":"@Output/surface.png"},
    {"control":"businessPrimary","module":"Part","action":"Start","parameters":{"threshold":"$surface.result.isoEstimate.iso"},"expectPrimaryAction":"Start","expectStatus":"Succeeded","screenshot":"@Output/parts.png"},
    {"control":"businessPrimary","module":"Gap","action":"Start","parameters":{"isoMode":"AbsoluteValue","absoluteIsoValue":"$surface.result.isoEstimate.iso","filter":false,"evaluationRoi":"$roi.result.roi"},"expectPrimaryAction":"Start","expectStatus":"Succeeded","saveAs":"gap"},
    {"control":"businessPrimary","module":"Gap","action":"Defects","expectPrimaryAction":"Defects","expectStatus":"Observed","showStatistics":true,"waitStatistics":true,"statisticsAudit":"@Output/gap-statistics.json","screenshot":"@Output/gap.png"},
    {"control":"businessPrimary","module":"View","action":"Set","parameters":{"viewId":"primary-3d","mode":"CompositeIsoSurface","opacity":0},"expectStatus":"Succeeded"},
    {"module":"Crop","action":"Start","parameters":{"shape":"Box","removalMode":"KeepInside"},"expectStatus":"Rejected"},
    {"control":"businessPrimary","module":"View","action":"Set","parameters":{"viewId":"primary-3d","mode":"CompositeVolume","opacity":1},"expectStatus":"Succeeded"},
    {"control":"businessPrimary","module":"Crop","action":"Start","parameters":{"shape":"Box","removalMode":"KeepInside"},"waitForCropFrames":true,"expectPrimaryAction":"Start","expectStatus":"Succeeded","cropDrag":true},
    {"control":"businessPrimary","module":"Crop","action":"FinishEditing","waitForCropFrames":true,"expectPrimaryAction":"FinishEditing","expectStatus":"PreviewConfirmed"},
    {"control":"businessPrimary","module":"Crop","action":"BuildResult","waitForCropFrames":true,"expectPrimaryAction":"BuildResult","expectStatus":"Published","expectFollowupStatus":"Succeeded","expectAdoptPublished":true,"screenshot":"@Output/crop-used.png"}
  ]
}
