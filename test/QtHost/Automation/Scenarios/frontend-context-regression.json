{
  "schema":"qt-control-scenario-1",
  "checkWindowStable":true,
  "viewsVisible":true,
  "viewLayout":"Inspection",
  "steps":[
    {"control":"businessPrimary","module":"Data","action":"Load","parameters":{},"expectPrimaryAction":"Load","expectStatus":"Succeeded","saveAs":"loaded","showStatistics":true,"waitHistogram":true,"statisticsAudit":"@Output/input-statistics.json","screenshot":"@Output/input.png"},
    {"control":"businessPrimary","module":"View","action":"Set","parameters":{"viewId":"primary-3d","mode":"CompositeVolume","opacity":0.6},"expectPrimaryAction":"Set","expectStatus":"Succeeded"},
    {"control":"editParameters","module":"View","action":"Set","parameters":{"opacity":0.8},"expectPrimaryAction":"Set","expectState":{"parametersChanged":true}},
    {"control":"currentPrimary","module":"View","action":"Set","expectPrimaryAction":"Set","expectStatus":"Succeeded","expectState":{"parametersChanged":false},"showStatistics":true,"waitHistogram":true,"screenshot":"@Output/view-applied.png"},
    {"control":"actionButton","module":"Rotation","action":"SetEnabled","parameters":{"isEnabled":true},"expectStatus":"Succeeded"},
    {"control":"editParameters","module":"Rotation","action":"SetEnabled","parameters":{"isEnabled":false},"expectPrimaryAction":"SetEnabled"},
    {"control":"currentPrimary","module":"Rotation","action":"SetEnabled","expectPrimaryAction":"SetEnabled","expectStatus":"Succeeded","expectState":{"isEnabled":false}},
    {"control":"businessPrimary","module":"Alignment","action":"EvaluateVoxelVolume","parameters":{"source":"current","storedValueRange":[-1e30,1e30],"extent":null},"expectPrimaryAction":"EvaluateVoxelVolume","expectStatus":"FullyDetermined"},
    {"control":"currentPrimary","module":"Alignment","action":"VoxelVolumeResult","expectPrimaryAction":"VoxelVolumeResult","expectStatus":"Observed","saveAs":"nativeA"},
    {"control":"businessPrimary","module":"Roi","action":"Begin","expectPrimaryAction":"Begin","expectStatus":"Succeeded"},
    {"control":"editParameters","module":"Roi","action":"SetDraft","parameters":{"name":"完整 CT 数值区域 B","centerMM":[-118,-118,118],"sizeMM":[140,140,140],"direction3D":[1,0,0,0,1,0,0,0,1]},"expectPrimaryAction":"SetDraft","expectState":{"draftParametersChanged":true}},
    {"control":"currentPrimary","module":"Roi","action":"SetDraft","expectPrimaryAction":"SetDraft","expectStatus":"Succeeded","expectState":{"draftParametersChanged":false},"showStatistics":true,"waitHistogram":true,"statisticsAudit":"@Output/roi-draft-B-statistics.json","screenshot":"@Output/roi-draft-B.png"},
    {"control":"currentPrimary","module":"Roi","action":"Commit","expectPrimaryAction":"Commit","expectStatus":"Succeeded","saveAs":"roiB"},
    {"control":"nextButton","module":"Roi","action":"OpenCrop","expectStatus":"ParametersCopied"},
    {"control":"currentPrimary","module":"Crop","action":"PrepareRoi","expectPrimaryAction":"PrepareRoi","expectStatus":"ParametersCopied"},
    {"control":"currentPrimary","module":"Crop","action":"FinishEditing","waitForCropFrames":true,"expectPrimaryAction":"FinishEditing","expectStatus":"PreviewConfirmed","expectState":{"nodeCount":"0","roiOnly":true}},
    {"control":"actionButton","module":"Crop","action":"BuildResult","waitForCropFrames":true,"expectStatus":"Published","saveAs":"oldCrop","showStatistics":true,"waitHistogram":true,"statisticsAudit":"@Output/root-roi-output-statistics.json"},
    {"control":"businessPrimary","module":"Artifact","action":"Diffusion","parameters":{"diffusion":{"iterations":1,"threshold":1,"factor":0.25,"slabDepth":8}},"expectPrimaryAction":"Diffusion","expectStatus":"Ready","expectState":{"isCandidateCurrent":true}},
    {"control":"actionButton","module":"Crop","action":"Start","parameters":{"shape":"Box","removalMode":"KeepInside"},"waitForCropFrames":true,"expectStatus":"Succeeded"},
    {"control":"actionButton","module":"Crop","action":"AppendExact","parameters":{"matrix":[50,0,0,-118,0,50,0,-118,0,0,50,118,0,0,0,1]},"expectStatus":"Succeeded","showStatistics":true,"waitHistogram":true,"statisticsAudit":"@Output/new-preview-statistics.json","stateAudit":"@Output/new-preview-state.json"},
    {"control":"currentPrimary","module":"Crop","action":"FinishEditing","waitForCropFrames":true,"expectPrimaryAction":"FinishEditing","expectStatus":"PreviewConfirmed"},
    {"control":"currentPrimary","module":"Crop","action":"BuildResult","waitForCropFrames":true,"expectPrimaryAction":"BuildResult","expectStatus":"Published","expectFollowupStatus":"Succeeded","expectAdoptPublished":true,"saveAs":"newCrop","showStatistics":true,"waitHistogram":true,"statisticsAudit":"@Output/new-output-statistics.json","screenshot":"@Output/new-crop-adopted.png"},
    {"control":"checkPage","module":"Data","expectPrimaryAction":"Load","expectState":{"activationFailed":false}},
    {"control":"businessPrimary","module":"Alignment","action":"EvaluateVoxelVolume","parameters":{"source":"current","storedValueRange":[-1e30,1e30],"extent":null},"expectPrimaryAction":"EvaluateVoxelVolume","expectStatus":"FullyDetermined"},
    {"control":"currentPrimary","module":"Alignment","action":"VoxelVolumeResult","expectPrimaryAction":"VoxelVolumeResult","expectStatus":"Observed","saveAs":"nativeB","stateAudit":"@Output/cropped-native-volume.json"},
    {"control":"actionButton","module":"Data","action":"Select","parameters":{"revision":"$loaded.current.dataRevision"},"expectStatus":"Succeeded"},
    {"control":"checkPage","module":"Artifact","expectPrimaryAction":"Recompute","expectState":{"isCandidateCurrent":false},"stateAudit":"@Output/aba-invalid-candidate.json"},
    {"control":"currentPrimary","module":"Artifact","action":"Recompute","expectPrimaryAction":"Recompute","expectStatus":"Ready","expectState":{"isCandidateCurrent":true}},
    {"control":"currentPrimary","module":"Artifact","action":"Commit","expectPrimaryAction":"Commit","expectStatus":"Published","expectFollowupStatus":"Succeeded","expectAdoptPublished":true,"saveAs":"corrected"},
    {"control":"checkPage","module":"Data","expectPrimaryAction":"Load","expectState":{"activationFailed":false},"screenshot":"@Output/corrected-input.png"},
    {"control":"actionButton","module":"Artifact","action":"RestoreSource","expectStatus":"Succeeded"},
    {"control":"actionButton","module":"Crop","action":"RestoreSource","expectStatus":"Failed","expectState":{"blockerCount":1,"failureReason":21},"saveAs":"cropReleaseBlockedByVolumeResult","stateAudit":"@Output/crop-release-blocked.json","screenshot":"@Output/crop-returned-source.png"},
    {"control":"businessPrimary","module":"Alignment","action":"EvaluateVoxelVolume","parameters":{"source":"current","storedValueRange":[0,65535],"extent":null},"expectPrimaryAction":"EvaluateVoxelVolume","expectStatus":"FullyDetermined"},
    {"control":"currentPrimary","module":"Alignment","action":"VoxelVolumeResult","expectPrimaryAction":"VoxelVolumeResult","expectStatus":"Observed","screenshot":"@Output/volume-natural-result.png"},
    {"control":"checkPage","module":"Crop","expectPrimaryAction":"Start","expectState":{"blockerCount":1,"failureReason":21}},
    {"control":"currentPrimary","module":"Crop","action":"Start","expectPrimaryAction":"Start","expectStatus":"Succeeded","expectState":{"blockerCount":0,"isActive":true},"stateAudit":"@Output/new-crop-after-retained-result.json","screenshot":"@Output/new-crop-after-retained-result.png"}
  ]
}
