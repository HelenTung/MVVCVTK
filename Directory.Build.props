<Project>
  <PropertyGroup>
    <MVVCVTKDepsVersion Condition="'$(MVVCVTKDepsVersion)' == ''">2026.08.21-deps.1</MVVCVTKDepsVersion>
    <MVVCVTKSdkBaseRoot Condition="'$(MVVCVTKSdkBaseRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)sdk'))</MVVCVTKSdkBaseRoot>
    <!-- source build 只读取版本化依赖输入；SDK 编译输出与 package stage 在 BuildSdk 中另行解析。 -->
    <MVVCVTKDepsBundleRoot Condition="'$(MVVCVTKDepsBundleRoot)' == '' and '$(MVVCVTKDepsRoot)' != ''">$(MVVCVTKDepsRoot)</MVVCVTKDepsBundleRoot>
    <MVVCVTKDepsBundleRoot Condition="'$(MVVCVTKDepsBundleRoot)' == ''">$(MVVCVTKSdkBaseRoot)\deps\$(MVVCVTKDepsVersion)-win-x64</MVVCVTKDepsBundleRoot>
    <MVVCVTKDepsRoot Condition="'$(MVVCVTKDepsRoot)' == ''">$(MVVCVTKDepsBundleRoot)</MVVCVTKDepsRoot>
    <MVVCVTKDepsProps>$(MVVCVTKDepsRoot)\MVVCVTK.Dependencies.props</MVVCVTKDepsProps>
  </PropertyGroup>

  <Import Project="$(MVVCVTKDepsProps)" Condition="Exists('$(MVVCVTKDepsProps)')" />

  <Target Name="MVVCVTKCheckDepsImport"
          BeforeTargets="PrepareForBuild"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="'$(MVVCVTKDepsImported)' != 'true'"
           Text="MVVCVTK dependencies $(MVVCVTKDepsVersion) were not found at '$(MVVCVTKDepsBundleRoot)'. Place the versioned dependency bundle under sdk\deps or set /p:MVVCVTKDepsBundleRoot=&lt;path&gt;." />
    <Error Condition="'$(MVVCVTKDepsImported)' == 'true' and '$(MVVCVTKDepsResolvedVersion)' != '$(MVVCVTKDepsVersion)'"
           Text="MVVCVTK dependency version mismatch. Expected '$(MVVCVTKDepsVersion)', found '$(MVVCVTKDepsResolvedVersion)' at '$(MVVCVTKDepsRoot)'." />
  </Target>
</Project>
