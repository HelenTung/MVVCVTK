include(CMakeFindDependencyMacro)

if(DEFINED MVVCVTK_DEPS_ROOT AND NOT MVVCVTK_DEPS_ROOT STREQUAL "")
    set(_mvvcvtk_deps_root "${MVVCVTK_DEPS_ROOT}")
else()
    set(_mvvcvtk_deps_root "${PACKAGE_PREFIX_DIR}/deps/official")
endif()
cmake_path(NORMAL_PATH _mvvcvtk_deps_root)

foreach(_mvvcvtk_required_path IN ITEMS
    "vtk/lib/cmake/vtk-9.4/vtk-config.cmake"
    "opencv/x64/vc16/lib/OpenCVConfig.cmake"
)
    if(NOT EXISTS "${_mvvcvtk_deps_root}/${_mvvcvtk_required_path}")
        set(MVVCVTK_FOUND FALSE)
        set(MVVCVTK_NOT_FOUND_MESSAGE
            "MVVCVTK dependency is missing: ${_mvvcvtk_required_path}"
        )
        return()
    endif()
endforeach()

find_dependency(
    VTK 9.4.2 EXACT
    CONFIG
    COMPONENTS @MVVCVTK_VTK_COMPONENTS@
    PATHS "${_mvvcvtk_deps_root}/vtk/lib/cmake/vtk-9.4"
    NO_DEFAULT_PATH
)
find_dependency(
    OpenCV 4.12.0 EXACT
    CONFIG
    PATHS "${_mvvcvtk_deps_root}/opencv/x64/vc16/lib"
    NO_DEFAULT_PATH
)

if(NOT TARGET opencv_world)
    set(MVVCVTK_FOUND FALSE)
    set(MVVCVTK_NOT_FOUND_MESSAGE
        "The packaged OpenCV config does not define opencv_world."
    )
    return()
endif()

unset(_mvvcvtk_deps_root)
unset(_mvvcvtk_required_path)
