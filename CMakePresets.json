{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 2,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "vs2026-x64",
      "displayName": "Visual Studio 2026 x64",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "toolset": "v145,host=x64",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "MVVCVTK_BUILD_TESTING": true,
        "MVVCVTK_BUILD_QT_TESTING": true,
        "MVVCVTK_BUILD_QT_MANUAL": true,
        "MVVCVTK_BUILD_ORTHOGONAL_CROP": true,
        "MVVCVTK_BUILD_GAP_ANALYSIS": true,
        "MVVCVTK_BUILD_PART_SEGMENTATION": true,
        "MVVCVTK_BUILD_SURFACE_DETERMINATION": true,
        "MVVCVTK_BUILD_ARTIFACT_REDUCTION": true,
        "MVVCVTK_BUILD_MODEL_ROTATION": true,
        "MVVCVTK_BUILD_METROLOGY_ALIGNMENT": true,
        "MVVCVTK_ENABLE_AVX2": true
      }
    }
  ],
  "buildPresets": [
    {
      "name": "vs2026-debug",
      "configurePreset": "vs2026-x64",
      "configuration": "Debug"
    },
    {
      "name": "vs2026-release",
      "configurePreset": "vs2026-x64",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "vs2026-debug",
      "configurePreset": "vs2026-x64",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "vs2026-release",
      "configurePreset": "vs2026-x64",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
